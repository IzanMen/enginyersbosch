---
import ButtonLink from './ButtonLink.astro';
import { contact, languages, pageHref, ui, type Lang, type PageKey } from '../data/site';

interface Props { lang: Lang; current: PageKey; }
const { lang, current } = Astro.props;
const copy = ui[lang];
const items: Array<[PageKey, string]> = [['services', copy.nav.services], ['projects', copy.nav.projects], ['contact', copy.nav.contact]];
---
<header class="site-header-wrap">
  <div class="site-header shell">
    <a class="brand" href={pageHref(lang, 'home')} aria-label={`Enginyers Bosch — ${copy.nav.home}`}>
      <img class="logo" src="/images/logo.webp" width="266" height="64" alt="Enginyers Bosch" />
    </a>
    <nav class="desktop-nav" aria-label="Principal">
      {items.map(([key, label]) => <a href={pageHref(lang, key)} aria-current={current === key ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="social-links" aria-label="Xarxes socials">
      <a href={contact.instagram} target="_blank" rel="noreferrer" aria-label="Instagram">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm8.7 2.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" fill="currentColor" /></svg>
      </a>
      <a href={contact.facebook} target="_blank" rel="noreferrer" aria-label="Facebook">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M14 8.25V6.6c0-.78.24-1.1 1.15-1.1H17V2.13A23.8 23.8 0 0 0 14.3 2C11.62 2 9.8 3.64 9.8 6.25v2H7v3.78h2.8V22H14v-9.97h2.8l.45-3.78H14Z" fill="currentColor" /></svg>
      </a>
    </div>
    <details class="language-switcher">
      <summary aria-label="Idioma">{copy.localeName}<span aria-hidden="true">⌄</span></summary>
      <div>{languages.filter((code) => code !== lang).map((code) => <a href={pageHref(code, current)}>{ui[code].localeName}</a>)}</div>
    </details>
    <ButtonLink href={contact.whatsappHref} label={copy.contactCta} class="header-cta" />
    <details class="mobile-menu">
      <summary aria-label="Menu"><span></span><span></span></summary>
      <div class="mobile-panel">
        <nav aria-label="Principal">
          <a href={pageHref(lang, 'home')}>{copy.nav.home}</a>
          {items.map(([key, label]) => <a href={pageHref(lang, key)} aria-current={current === key ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="mobile-social-links" aria-label="Xarxes socials">
          <a href={contact.instagram} target="_blank" rel="noreferrer" aria-label="Instagram">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm8.7 2.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" fill="currentColor" /></svg>
          </a>
          <a href={contact.facebook} target="_blank" rel="noreferrer" aria-label="Facebook">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M14 8.25V6.6c0-.78.24-1.1 1.15-1.1H17V2.13A23.8 23.8 0 0 0 14.3 2C11.62 2 9.8 3.64 9.8 6.25v2H7v3.78h2.8V22H14v-9.97h2.8l.45-3.78H14Z" fill="currentColor" /></svg>
          </a>
        </div>
        <div class="mobile-languages">{languages.map((code) => <a href={pageHref(code, current)} aria-current={code === lang ? 'true' : undefined}>{ui[code].localeName}</a>)}</div>
        <ButtonLink href={contact.whatsappHref} label={copy.contactCta} />
      </div>
    </details>
  </div>
</header>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') mobileMenu?.removeAttribute('open');
  });
  document.addEventListener('click', (event) => {
    if (!mobileMenu?.open || mobileMenu.contains(event.target as Node)) return;
    mobileMenu.removeAttribute('open');
  });
</script>
