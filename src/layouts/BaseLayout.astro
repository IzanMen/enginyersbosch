---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { languages, pageHref, type Lang, type PageKey } from '../data/site';

interface Props {
  lang: Lang;
  current: PageKey;
  title: string;
  description: string;
  image?: string;
}

const { lang, current, title, description, image = '/og.png' } = Astro.props;
const origin = 'https://www.enginyersbosch.com';
const canonical = `${origin}${pageHref(lang, current)}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#213c58" />
    <link rel="canonical" href={canonical} />
    {languages.map((code) => <link rel="alternate" hreflang={code} href={`${origin}${pageHref(code, current)}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${origin}${pageHref('ca', current)}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${origin}${image}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}${image}`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/montserrat.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header lang={lang} current={current} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
  </body>
</html>
