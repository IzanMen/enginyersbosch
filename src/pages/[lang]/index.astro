---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import ContactStrip from '../../components/ContactStrip.astro';
import { home, languages, pageHref, projects, services, ui, type Lang } from '../../data/site';

export const prerender = true;

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang ?? 'ca') as Lang;
const copy = home[lang];
const common = ui[lang];
const serviceItems = services[lang];
const projectItems = projects[lang].slice(0, 4);
const [titleBefore, titleAfter = ''] = copy.title.split(copy.outlined);
---

<BaseLayout lang={lang} current="home" title={`Enginyers Bosch — ${copy.title}`} description={copy.intro}>
  <section class="hero shell">
    <div class="hero-copy">
      <h1>{titleBefore}<em>{copy.outlined}</em>{titleAfter}</h1>
      <div>
        <p>{copy.intro}</p>
        <ButtonLink href={pageHref(lang, 'contact')} label={common.contactCta} outline />
      </div>
    </div>
    <div class="hero-media">
      <img src="/images/hero.webp" width="1920" height="1280" alt="Projecte Casas del Lago a Cala'n Bosch" fetchpriority="high" />
      <div class="hero-label"><span>Enginyers Bosch</span><strong>Ciutadella de Menorca</strong></div>
    </div>
  </section>

  <section class="stats shell" aria-label="Trajectòria">
    <article class="stat-aqua"><strong>40+</strong><span>{copy.statYears}</span></article>
    <article class="stat-purple"><strong>3.500</strong><span>{copy.statFiles}</span></article>
    <article class="stat-coral"><strong>01</strong><span>{copy.statPlace}</span></article>
    <article class="stat-sand"><strong>1985</strong><span>{copy.statSince}</span></article>
  </section>

  <section class="section services-preview">
    <div class="shell section-lead">
      <div><p class="eyebrow">{copy.servicesEyebrow}</p><h2>{copy.servicesTitle}</h2></div>
      <div><p>{copy.servicesIntro}</p><ButtonLink href={pageHref(lang, 'services')} label={common.learnMore} outline /></div>
    </div>
    <div class="service-index shell">
      {serviceItems.map((service) => (
        <a href={`${pageHref(lang, 'services')}#${service.id}`}>
          <h3>{service.title}</h3>
          <svg aria-hidden="true" viewBox="0 0 17 11"><path d="M9.96.181a.5.5 0 0 1 .704-.067l5.908 4.877a.502.502 0 0 1 0 .771l-5.909 4.876a.5.5 0 0 1-.635-.771l4.834-3.99H.5a.5.5 0 0 1 0-1h14.362L10.028.885a.5.5 0 0 1-.067-.704Z" fill="currentColor" /></svg>
        </a>
      ))}
    </div>
  </section>

  <section class="section projects-preview">
    <div class="shell project-carousel-layout">
      <div class="project-side">
        <p class="eyebrow">{copy.projectsEyebrow}</p>
        <h2>{copy.projectsTitle}</h2>
        <p>{copy.projectsIntro}</p>
        <ButtonLink href={pageHref(lang, 'projects')} label={common.viewAll} outline />
        <div class="carousel-controls" aria-label="Carousel">
          <button type="button" data-carousel-prev aria-label="Anterior">←</button>
          <button type="button" data-carousel-next aria-label="Següent">→</button>
        </div>
      </div>
      <div class="project-track" data-carousel>
        {projectItems.map((project) => (
          <article class="project-card">
            <img src={project.image} width="960" height="640" alt={project.title} loading="lazy" />
            <div><span>{project.category}</span><h3>{project.title}</h3><p>{project.description}</p><a href={pageHref(lang, 'projects')}>{common.learnMore}<b aria-hidden="true">→</b></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section trust-section">
    <div class="shell trust-grid">
      <div class="trust-image"><img src="/images/diskont.webp" width="960" height="640" alt="Projecte industrial DISKONT" loading="lazy" /></div>
      <div class="trust-content">
        <p class="eyebrow">{copy.trustEyebrow}</p>
        <h2>{copy.trustTitle}</h2>
        <p class="trust-intro">{copy.trustBody}</p>
        <div class="reviews-panel" data-reviews>
          <div class="reviews-heading">
            <div class="google-source" aria-label="Google">
              <span class="google-blue">G</span><span class="google-red">o</span><span class="google-yellow">o</span><span class="google-blue">g</span><span class="google-green">l</span><span class="google-red">e</span>
            </div>
            <strong>{copy.reviewsTitle}</strong>
          </div>
          <div class="review-track" data-review-track tabindex="0">
            {copy.reviews.map((review) => (
              <article class="review-card">
                <span class="review-quote" aria-hidden="true">“</span>
                <p>{review}</p>
                <footer>{copy.reviewSource}</footer>
              </article>
            ))}
          </div>
          <div class="review-controls">
            <span aria-live="polite"><b data-review-current>01</b> / {String(copy.reviews.length).padStart(2, '0')}</span>
            <div>
              <button type="button" data-review-prev aria-label={copy.reviewsPrevious}>←</button>
              <button type="button" data-review-next aria-label={copy.reviewsNext}>→</button>
            </div>
          </div>
        </div>
        <ButtonLink href={pageHref(lang, 'contact')} label={common.contactCta} light />
      </div>
    </div>
  </section>

  <ContactStrip lang={lang} />
</BaseLayout>

<script>
  const track = document.querySelector('[data-carousel]');
  const move = (direction: number) => {
    if (!(track instanceof HTMLElement)) return;
    track.scrollBy({ left: direction * Math.min(track.clientWidth * 0.8, 440), behavior: 'smooth' });
  };
  document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => move(-1));
  document.querySelector('[data-carousel-next]')?.addEventListener('click', () => move(1));

  const reviewTrack = document.querySelector('[data-review-track]');
  const reviewCurrent = document.querySelector('[data-review-current]');
  const moveReview = (direction: number) => {
    if (!(reviewTrack instanceof HTMLElement)) return;
    reviewTrack.scrollBy({ left: direction * reviewTrack.clientWidth, behavior: 'smooth' });
  };
  const updateReviewCount = () => {
    if (!(reviewTrack instanceof HTMLElement) || !(reviewCurrent instanceof HTMLElement)) return;
    const index = Math.round(reviewTrack.scrollLeft / reviewTrack.clientWidth);
    reviewCurrent.textContent = String(index + 1).padStart(2, '0');
  };
  document.querySelector('[data-review-prev]')?.addEventListener('click', () => moveReview(-1));
  document.querySelector('[data-review-next]')?.addEventListener('click', () => moveReview(1));
  reviewTrack?.addEventListener('scrollend', updateReviewCount);
  reviewTrack?.addEventListener('scroll', () => requestAnimationFrame(updateReviewCount), { passive: true });
</script>
